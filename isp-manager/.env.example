DATABASE_URL="postgresql://isp:isp123@localhost:5434/isp_manager"
# Generá un secreto FUERTE y ÚNICO por entorno: `openssl rand -base64 32`
# Nunca reutilices este placeholder: en producción la app no arranca con un valor inseguro.
NEXTAUTH_SECRET="REEMPLAZAR-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Credenciales del admin inicial que crea `npm run db:seed`.
# Sin valores por defecto: definí ambas o el seed falla. No uses contraseñas de ejemplo.
SEED_ADMIN_EMAIL="admin@tu-empresa.com"
SEED_ADMIN_PASSWORD="REEMPLAZAR-con-una-contraseña-fuerte"

# (Opcional) Credenciales de la base local de Docker. Default dev: isp / isp123 / isp_manager.
# POSTGRES_USER="isp"
# POSTGRES_PASSWORD="isp123"
# POSTGRES_DB="isp_manager"

# ─── Módulo RED (FTTH/ONUs) ──────────────────────────────────────────────────
# WisPro: API del ISP. El token se obtiene en Configuración avanzada/ISP de WisPro.
WISPRO_API_URL="https://www.cloud.wispro.co/api/v1"
WISPRO_API_TOKEN="REEMPLAZAR-con-el-API-Token-del-ISP"

# Panel de ONUs por OLT (fuente PANEL). Una entrada por OLT con panel propio.
PANEL_MOLLAR_URL="http://IP-DEL-PANEL"
PANEL_MOLLAR_USER="usuario"
PANEL_MOLLAR_PASS="REEMPLAZAR"

# Token de servicio para el endpoint /api/red/configuracion (reporte de vsol-config).
# Generá uno propio: `openssl rand -hex 32`.
VSOL_REPORT_TOKEN="REEMPLAZAR-con-openssl-rand-hex-32"
